///|
test "upstream basic token signature chain" {
  @biscuit.verify_signatures(test001_basic, root_key)
}

///|
test "verified authority facts are decoded for inspection" {
  let facts = @biscuit.verify_authority_facts(test001_basic, root_key)
  assert_eq(facts.length(), 3)
  let file1_read = @biscuit.parse_query("right(\"file1\", \"read\")")
  let file2_read = @biscuit.parse_query("right(\"file2\", \"read\")")
  let file1_write = @biscuit.parse_query("right(\"file1\", \"write\")")
  assert_eq(@biscuit.match_query(file1_read, facts).length(), 1)
  assert_eq(@biscuit.match_query(file2_read, facts).length(), 1)
  assert_eq(@biscuit.match_query(file1_write, facts).length(), 1)
}

///|
test "authority fact inspection still verifies signatures first" {
  let accepted = try {
    ignore(@biscuit.verify_authority_facts(test005_invalid_signature, root_key))
    true
  } catch {
    @biscuit.InvalidSignature => false
    _ => abort("expected signature verification failure")
  }
  assert_false(accepted)
}

///|
test "verified facts retain block boundaries and shared symbols" {
  let appended_block = b"\x18\x03\x22\x0d\x0a\x0b\x08\x04\x12\x03\x18\x80\x08\x12\x02\x18\x00"
  let token = @biscuit.append_raw(
    test001_basic,
    root_key,
    appended_block,
    Bytes::make(32, b'\x43'),
  )
  let blocks = @biscuit.verify_block_facts(token, root_key)
  assert_eq(blocks.length(), 3)
  assert_eq(blocks[0].index, 0)
  assert_eq(blocks[0].facts.length(), 3)
  assert_eq(blocks[1].index, 1)
  assert_eq(blocks[2].index, 2)
  assert_eq(blocks[2].facts.length(), 1)
  let query = @biscuit.parse_query("right(\"file1\", \"read\")")
  assert_eq(@biscuit.match_query(query, blocks[2].facts).length(), 1)
  assert_eq(@biscuit.verify_authority_facts(token, root_key).length(), 3)
}

///|
test "upstream sealed token signature chain" {
  @biscuit.verify_signatures(test020_sealed, root_key)
}

///|
test "upstream corrupted signatures are rejected" {
  let accepted = try {
    @biscuit.verify_signatures(test005_invalid_signature, root_key)
    true
  } catch {
    _ => false
  }
  assert_false(accepted)
}

///|
test "upstream reordered blocks are rejected" {
  let accepted = try {
    @biscuit.verify_signatures(test006_reordered_blocks, root_key)
    true
  } catch {
    _ => false
  }
  assert_false(accepted)
}

