let test036_secp256r1 : Bytes = b"\x12\xaa\x01\x0a\x3d\x0a\x05\x66\x69\x6c\x65\x31\x0a\x05\x66\x69\x6c\x65\x32\x18\x03\x22\x0d\x0a\x0b\x08\x04\x12\x03\x18\x80\x08\x12\x02\x18\x00\x22\x0d\x0a\x0b\x08\x04\x12\x03\x18\x81\x08\x12\x02\x18\x00\x22\x0d\x0a\x0b\x08\x04\x12\x03\x18\x80\x08\x12\x02\x18\x01\x12\x25\x08\x01\x12\x21\x02\x5e\x91\x8f\xd4\x46\x38\x32\xae\xa2\x82\x3d\xfd\x97\x16\xa3\x6b\x4d\x9b\x13\x77\xbd\x53\xdd\x82\xdd\xf4\xc0\xbc\x75\xed\x6b\xbf\x1a\x40\x62\x8b\x9a\x6d\x74\xcc\x80\xb3\xec\xe5\x0b\xef\xd1\xf5\xf0\xf0\x25\xc0\xa3\x5d\x51\x70\x8b\x2e\x77\xc1\x1a\xed\x5f\x96\x8b\x93\xb4\x09\x6c\x87\xed\x81\x69\x60\x57\x16\xde\x93\x4e\x15\x54\x43\xf1\x40\x33\x4d\x71\x70\x8f\xcc\x42\x47\xe5\xa0\xa5\x18\xb3\x0d\x28\x01\x1a\xa0\x01\x0a\x2b\x0a\x01\x30\x18\x03\x32\x24\x0a\x22\x0a\x02\x08\x1b\x12\x07\x08\x02\x12\x03\x08\x82\x08\x12\x06\x08\x03\x12\x02\x18\x00\x12\x0b\x08\x04\x12\x03\x08\x82\x08\x12\x02\x18\x00\x12\x25\x08\x01\x12\x21\x02\x7a\x29\xe8\x39\x1c\xb1\xeb\x5c\xb7\x8a\xf8\xc0\x24\x1a\x06\xc7\x13\xe2\x7e\x34\xd7\x6e\x5b\x76\x50\x43\xc2\xe9\xf2\xa9\x90\xee\x1a\x48\x30\x46\x02\x21\x00\xb6\x06\x74\x85\x4a\x12\x81\x4c\xc3\x6c\x8a\xab\x96\x00\xc1\xd9\xf9\xd3\x16\x0e\x23\x34\xb7\x2c\x0f\xee\xde\x5a\x56\x21\x3e\xa5\x02\x21\x00\xa4\xf4\xbb\xf2\xdc\x33\xb3\x09\x26\x7a\xf3\x9f\xce\x76\x61\x20\x17\xdd\xb6\x17\x1e\x9c\xd2\xa3\xaa\x8a\x85\x3f\x45\xf1\x67\x5f\x28\x01\x22\x22\x0a\x20\xca\x41\xda\xb0\x85\x90\xed\xa4\x42\x31\xb6\xfc\xf4\xbb\x11\x0c\x85\x2b\x24\xf0\x30\xbf\x99\x6a\x89\xf0\x2c\xcc\xc5\x7e\xb5\xf1"

///|
test "upstream v1 signature is accepted" {
  @biscuit.verify_signatures(test029_reject_if, root_key)
}

///|
test "version 6 reject check is decoded without running expressions" {
  let programs = @biscuit.verify_block_programs(test029_reject_if, root_key)
  assert_eq(programs.length(), 1)
  assert_eq(programs[0].checks.length(), 1)
  assert_true(
    match programs[0].checks[0].mode {
      @biscuit.Reject => true
      _ => false
    },
  )
  assert_true(programs[0].has_unsupported_expressions)
  assert_false(programs[0].has_scopes)
}

///|
test "token authorization rejects checks with expression bytecode" {
  let rejected = try {
    @biscuit.authorize_token(test029_reject_if, root_key, [], [], [], 100, 20)
    false
  } catch {
    @biscuit.UnsupportedTokenFeature(_) => true
    _ => false
  }
  assert_true(rejected)
}

///|
test "unsupported third-party blocks are rejected" {
  let accepted = try {
    @biscuit.verify_signatures(test024_third_party, root_key)
    true
  } catch {
    @biscuit.Unsupported(_) => false
    _ => abort("expected Unsupported")
  }
  assert_false(accepted)
}

///|
test "unsupported secp256r1 blocks are rejected" {
  let accepted = try {
    @biscuit.verify_signatures(test036_secp256r1, root_key)
    true
  } catch {
    @biscuit.Unsupported(_) => false
    _ => abort("expected Unsupported")
  }
  assert_false(accepted)
}

///|
test "malformed and oversized tokens are rejected" {
  for
    token in [
      b"",
      b"\x12\x80",
      b"\x12\xff\xff\xff\xff\xff",
      Bytes::make(1048577, b'\x00'),
    ] {
    let accepted = try {
      @biscuit.verify_signatures(token, root_key)
      true
    } catch {
      _ => false
    }
    assert_false(accepted)
  }
}

///|
test "wrong root and altered final proof are rejected" {
  let wrong_root = Bytes::make(32, b'\x00')
  let altered = Bytes::makei(test001_basic.length(), fn(i) {
    if i == test001_basic.length() - 1 {
      test001_basic[i] ^ b'\x01'
    } else {
      test001_basic[i]
    }
  })
  for (token, key) in [(test001_basic, wrong_root), (altered, root_key)] {
    let rejected = try {
      @biscuit.verify_signatures(token, key)
      false
    } catch {
      @biscuit.InvalidSignature => true
      _ => false
    }
    assert_true(rejected)
  }
}

///|
test "append a v1 block to an upstream token" {
  let new_seed = Bytes::make(32, b'\x43')
  let result = @biscuit.append_raw(
    test001_basic, root_key, b"\x18\x03", new_seed,
  )
  @biscuit.verify_signatures(result, root_key)
}

///|
test "sealed or untrusted tokens cannot be appended" {
  let seed = Bytes::make(32, b'\x43')
  for token in [test020_sealed, test005_invalid_signature] {
    let accepted = try {
      ignore(@biscuit.append_raw(token, root_key, b"\x18\x03", seed))
      true
    } catch {
      _ => false
    }
    assert_false(accepted)
  }
}
