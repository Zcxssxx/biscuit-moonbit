}

///|
test "official test032_laziness_closures shadowing" {
  let actual = run_official_sample(
    "-CgIIGxo4ChAKDjoMCgIQAQoCEAIKAhADChgiFgiBCBIFCgMIgQgSBAoCEAISBBoCCBUKBBoCCBkKBBICCAAyOgo4CgIIGxoyChAKDjoMCgIQAQoCEAIKAhADChgiFgiBCBIFCgMIgQgSBAoCEAISBBoCCAEKBBoCCBoyQAo-_2NP76gu4m2ZcMxoqohMeC47LOLNVAnXUzNjbNdpsRDPu0dRWz7dh4_zHhFiU2JHphsoESwIoASIiCiCZ6HsOkVhTHu61A_8VJm4rI8KiUHsTjJ0bHyq0WN8tYQ",
    "allow if {\"true\"}.any($p -> {\"true\"}.all($p -> $p));\n", false,
  )
  assert_eq(actual, "shadowed_variable")
}

