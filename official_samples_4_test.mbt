///|
test "official test030_null default" {
  let actual = run_official_sample(
    "EtMBCmcKBGZhY3QKBXZhbHVlGAYyKQonCgIIGxIMCIAIEgJCABIDCIEIGhMKBQoDCIEICgQKAkIACgQaAggVMisKJwoCCBsSDAiACBICQgASAwiBCBoTCgUKAwiBCAoECgJCAAoEGgIIFhACEiQIABIgEFXHULGhUFk3rxU3xia6MmOZXDOmR1iqr7EnWwMS4oQaQP5Q1lcGpZRcdladH_K-js4kJ2hXYx6W76BZWfc7tOqMdylFc4oB2nehZhrvK4IztPTkmuIg8sgf0LjaWcISdQsoASIiCiCZ6HsOkVhTHu61A_8VJm4rI8KiUHsTjJ0bHyq0WN8tYQ",
    "fact(null, null);\n\nallow if true;\n", false,
  )
  assert_eq(actual, "ok")
}

