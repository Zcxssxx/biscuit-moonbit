///|
test "official test031_heterogeneous_equal default" {
  let actual = run_official_sample(
    "-xJ1sDEuKEGkC-ULIED0tf4ni4eBWRDSSe65ylI4yuTqU44ir9oR9XboaMv-fmsKA7Aq4PIiOeyQiUfUutWoeOS597195z5ckKKAEiIgogmeh7DpFYUx7utQP_FSZuKyPColB7E4ydGx8qtFjfLWE",
    "fact(1, 1);\nfact2(1, 2);\n\nallow if true;\n", false,
  )
  assert_eq(actual, "ok")
}

///|
test "official test031_heterogeneous_equal evaluate to false" {
  let actual = run_official_sample(
    "-xJ1sDEuKEGkC-ULIED0tf4ni4eBWRDSSe65ylI4yuTqU44ir9oR9XboaMv-fmsKA7Aq4PIiOeyQiUfUutWoeOS597195z5ckKKAEiIgogmeh7DpFYUx7utQP_FSZuKyPColB7E4ydGx8qtFjfLWE",
    "fact(1, 2);\nfact2(1, 1);\n\ncheck if false != false;\n\nallow if true;\n",
    false,
  )
  assert_eq(actual, "denied")
}

