///|
test "official test038_try_op default" {
  let actual = run_official_sample(
    "-wQf2J9PYwJhHZGoNBsI5CkNUdxsuvcLMZpcfLXTvdE5OgRl2ACgBIiIKIJnoew6RWFMe7rUD_xUmbisjwqJQexOMnRsfKrRY3y1h",
    "allow if true;\n", false,
  )
  assert_eq(actual, "ok")
}

///|
test "official test038_try_op right-hand side does not catch errors" {
  let actual = run_official_sample(
    "-wQf2J9PYwJhHZGoNBsI5CkNUdxsuvcLMZpcfLXTvdE5OgRl2ACgBIiIKIJnoew6RWFMe7rUD_xUmbisjwqJQexOMnRsfKrRY3y1h",
    "check if true.try_or(true === 12);\n\nallow if true;\n", false,
  )
  assert_eq(actual, "expression_error")
}
