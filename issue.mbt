///|
fn encode_varint(value : Int32) -> Bytes {
  let result : Array[Byte] = []
  let mut n = value
  while n >= 128 {
    result.push(((n & 127) | 128).to_byte())
    n = n >> 7
  }
  result.push(n.to_byte())
  Bytes::from_array(result)
}

///|
fn encode_bytes_field(tag : Byte, value : Bytes) -> Bytes {
  Bytes::from_array([tag]) + encode_varint(value.length()) + value
}

///|
/// Create a raw Ed25519 Biscuit from an already serialized authority block.
/// Both seeds must be independently generated by a cryptographically secure RNG.
/// This function does not check the Datalog block or perform authorization.
/// The next seed is intentionally included in the bearer token for attenuation.
pub fn issue_raw(
  authority_block : Bytes,
  root_seed : Bytes,
  next_seed : Bytes,
) -> Bytes raise TokenError {
  if authority_block.length() > 1048000 {
    raise Malformed("authority block too large")
  }
  if root_seed.length() != 32 || next_seed.length() != 32 {
    raise Malformed("seed must be 32 bytes")
  }
  if root_seed == next_seed {
    raise Malformed("root and next seed must be different")
  }
  let next_key = @ed25519.derive_public_key(next_seed) catch {
    _ => raise Malformed("invalid next seed")
  }
  let sig = @ed25519.sign(
    root_seed,
    authority_payload_v1(authority_block, next_key),
  ) catch {
    _ => raise Malformed("invalid root seed")
  }
  let key = b"\x08\x00" + encode_bytes_field(b'\x12', next_key)
  let block = encode_bytes_field(b'\x0a', authority_block) +
    encode_bytes_field(b'\x12', key) +
    encode_bytes_field(b'\x1a', sig) +
    b"\x28\x01"
  let proof = encode_bytes_field(b'\x0a', next_seed)
  encode_bytes_field(b'\x12', block) + encode_bytes_field(b'\x22', proof)
}

///|
/// Append an already serialized block to an unsealed, signature-verified token.
/// `next_seed` must come from a cryptographically secure RNG and be fresh.
/// The block is not parsed or checked: the caller must use a conforming Biscuit
/// authorizer to enforce all checks and ensure the intended restriction.
pub fn append_raw(
  token : Bytes,
  root_key : Bytes,
  block_data : Bytes,
  next_seed : Bytes,
) -> Bytes raise TokenError {
  verify_signatures(token, root_key)
  if next_seed.length() != 32 {
    raise Malformed("seed must be 32 bytes")
  }
  if block_data.length() > 1048000 {
    raise Malformed("block too large")
  }
  let reader = Reader::{ data: token, pos: 0, }
  let mut prefix = b""
  let mut authority : SignedBlock? = None
  let mut last_block : SignedBlock? = None
  let mut proof : Bytes? = None
  let mut block_count = 0
  while reader.pos < token.length() {
    let start = reader.pos
    let tag = reader.varint()
    match tag {
      8 => ignore(reader.varint())
      18 => authority = Some(parse_block(reader.bytes()))
      26 => {
        last_block = Some(parse_block(reader.bytes()))
        block_count += 1
      }
      34 => proof = Some(reader.bytes())
      _ => raise Malformed("invalid token field")
    }
    if tag != 34 {
      prefix = prefix + token[start:reader.pos].to_owned()
    }
  }
  if block_count >= 128 {
    raise Malformed("too many blocks")
  }
  let last = match last_block {
    Some(block) => block
    None =>
      match authority {
        Some(block) => block
        None => raise Malformed("missing authority")
      }
  }
  let proof_bytes = match proof {
    Some(value) => value
    None => raise Malformed("missing proof")
  }
  let pr = Reader::{ data: proof_bytes, pos: 0, }
  if pr.varint() != 10 {
    raise Unsupported("sealed token")
  }
  let secret = pr.bytes()
  if secret == next_seed {
    raise Malformed("next seed must be fresh")
  }
  let next_key = @ed25519.derive_public_key(next_seed) catch {
    _ => raise Malformed("invalid next seed")
  }
  let unsigned = SignedBlock::{
    data: block_data,
    next_key,
    signature: b"",
    version: 1,
  }
  let signature = @ed25519.sign(
    secret,
    block_payload(unsigned, Some(last.signature)),
  ) catch {
    _ => raise Malformed("invalid proof secret")
  }
  let key = b"\x08\x00" + encode_bytes_field(b'\x12', next_key)
  let block = encode_bytes_field(b'\x0a', block_data) +
    encode_bytes_field(b'\x12', key) +
    encode_bytes_field(b'\x1a', signature) +
    b"\x28\x01"
  let new_proof = encode_bytes_field(b'\x0a', next_seed)
  let result = prefix +
    encode_bytes_field(b'\x1a', block) +
    encode_bytes_field(b'\x22', new_proof)
  if result.length() > 1048576 {
    raise Malformed("token exceeds 1 MiB")
  }
  result
}
