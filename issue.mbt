///|
fn encode_varint(value : Int32) -> Bytes {
  let result : Array[Byte] = []
  let mut n = value
  while n >= 128 {
    result.push(((n & 127) | 128).to_byte())
    n = n >> 7
  }
  result.push(n.to_byte())
  Bytes::from_array(result)
}

///|
fn encode_bytes_field(tag : Byte, value : Bytes) -> Bytes {
  Bytes::from_array([tag]) + encode_varint(value.length()) + value
}

///|
/// Create a raw Ed25519 Biscuit from an already serialized authority block.
/// Both seeds must be independently generated by a cryptographically secure RNG.
/// This function does not check the Datalog block or perform authorization.
/// The next seed is intentionally included in the bearer token for attenuation.
pub fn issue_raw(
  authority_block : Bytes,
  root_seed : Bytes,
  next_seed : Bytes,
) -> Bytes raise TokenError {
  issue_raw_with_keys(
    authority_block,
    { algorithm: Ed25519, secret: root_seed, },
    { algorithm: Ed25519, secret: next_seed, },
  )
}

///|
pub fn issue_raw_with_keys(
  authority_block : Bytes,
  root : SigningKey,
  next : SigningKey,
) -> Bytes raise TokenError {
  let root_seed = root.secret
  let next_seed = next.secret
  if authority_block.length() > 1048000 {
    raise Malformed("authority block too large")
  }
  if root_seed.length() != 32 || next_seed.length() != 32 {
    raise Malformed("seed must be 32 bytes")
  }
  if root.algorithm == next.algorithm && root_seed == next_seed {
    raise Malformed("root and next seed must be different")
  }
  let next_key = pack_key(verification_key(next)) catch {
    _ => raise Malformed("invalid next seed")
  }
  let sig = crypto_sign(root, authority_payload_v1(authority_block, next_key)) catch {
    _ => raise Malformed("invalid root seed")
  }
  let key = encode_public_key(next_key)
  let block = encode_bytes_field(b'\x0a', authority_block) +
    encode_bytes_field(b'\x12', key) +
    encode_bytes_field(b'\x1a', sig) +
    b"\x28\x01"
  let proof = encode_bytes_field(b'\x0a', next_seed)
  encode_bytes_field(b'\x12', block) + encode_bytes_field(b'\x22', proof)
}

///|
/// Seal an unsealed token so its holder can no longer append attenuation
/// blocks. The token's proof secret is replaced by a signature over the final
/// block, matching the Biscuit v3 Ed25519 proof format.
pub fn seal_token(token : Bytes, root_key : Bytes) -> Bytes raise TokenError {
  let blocks = verify_signed_chain(token, root_key)
  if blocks.length() == 0 {
    raise Malformed("token contains no blocks")
  }

  let reader = Reader::{ data: token, pos: 0, }
  let mut prefix = b""
  let mut encoded_proof : Bytes? = None
  while reader.pos < token.length() {
    let start = reader.pos
    let tag = reader.varint()
    match tag {
      8 => ignore(reader.varint())
      18 | 26 => ignore(reader.bytes())
      34 if encoded_proof is None => encoded_proof = Some(reader.bytes())
      _ => raise Malformed("invalid token proof layout")
    }
    if tag != 34 {
      prefix = prefix + token[start:reader.pos].to_owned()
    }
  }

  let proof = match encoded_proof {
    Some(value) => value
    None => raise Malformed("missing proof")
  }
  let proof_reader = Reader::{ data: proof, pos: 0, }
  if proof_reader.varint() != 10 {
    raise Unsupported("token is already sealed")
  }
  let secret = proof_reader.bytes()
  if proof_reader.pos != proof.length() {
    raise Malformed("invalid proof")
  }

  let last = blocks[blocks.length() - 1]
  let payload = last.data +
    algorithm_bytes(last.next_key) +
    key_bytes(last.next_key) +
    last.signature
  let signature = crypto_sign(
    { algorithm: key_algorithm(last.next_key), secret, },
    payload,
  ) catch {
    _ => raise Malformed("could not seal token")
  }
  let sealed_proof = encode_bytes_field(b'\x12', signature)
  let result = prefix + encode_bytes_field(b'\x22', sealed_proof)
  if result.length() > 1048576 {
    raise Malformed("token exceeds 1 MiB")
  }
  result
}

///|
/// Append an already serialized block to an unsealed, signature-verified token.
/// `next_seed` must come from a cryptographically secure RNG and be fresh.
/// The block is not parsed or checked: the caller must use a conforming Biscuit
/// authorizer to enforce all checks and ensure the intended restriction.
pub fn append_raw(
  token : Bytes,
  root_key : Bytes,
  block_data : Bytes,
  next_seed : Bytes,
) -> Bytes raise TokenError {
  append_raw_with_external(
    token,
    root_key,
    block_data,
    { algorithm: Ed25519, secret: next_seed, },
    None,
  )
}

///|
fn append_raw_with_external(
  token : Bytes,
  root_key : Bytes,
  block_data : Bytes,
  next : SigningKey,
  external_signature : ExternalSignature?,
) -> Bytes raise TokenError {
  verify_signatures(token, root_key)
  let next_seed = next.secret
  if next_seed.length() != 32 {
    raise Malformed("seed must be 32 bytes")
  }
  if block_data.length() > 1048000 {
    raise Malformed("block too large")
  }
  let reader = Reader::{ data: token, pos: 0, }
  let mut prefix = b""
  let mut authority : SignedBlock? = None
  let mut last_block : SignedBlock? = None
  let mut proof : Bytes? = None
  let mut block_count = 0
  while reader.pos < token.length() {
    let start = reader.pos
    let tag = reader.varint()
    match tag {
      8 => ignore(reader.varint())
      18 => authority = Some(parse_block(reader.bytes()))
      26 => {
        last_block = Some(parse_block(reader.bytes()))
        block_count += 1
      }
      34 => proof = Some(reader.bytes())
      _ => raise Malformed("invalid token field")
    }
    if tag != 34 {
      prefix = prefix + token[start:reader.pos].to_owned()
    }
  }
  if block_count >= 128 {
    raise Malformed("too many blocks")
  }
  let last = match last_block {
    Some(block) => block
    None =>
      match authority {
        Some(block) => block
        None => raise Malformed("missing authority")
      }
  }
  let proof_bytes = match proof {
    Some(value) => value
    None => raise Malformed("missing proof")
  }
  let pr = Reader::{ data: proof_bytes, pos: 0, }
  if pr.varint() != 10 {
    raise Unsupported("sealed token")
  }
  let secret = pr.bytes()
  if key_algorithm(last.next_key) == next.algorithm && secret == next_seed {
    raise Malformed("next seed must be fresh")
  }
  let next_key = pack_key(verification_key(next)) catch {
    _ => raise Malformed("invalid next seed")
  }
  let unsigned = SignedBlock::{
    data: block_data,
    next_key,
    signature: b"",
    version: 1,
    external_signature,
  }
  let signature = crypto_sign(
    { algorithm: key_algorithm(last.next_key), secret, },
    block_payload(unsigned, Some(last.signature)),
  ) catch {
    _ => raise Malformed("invalid proof secret")
  }
  let key = encode_public_key(next_key)
  let block = encode_bytes_field(b'\x0a', block_data) +
    encode_bytes_field(b'\x12', key) +
    encode_bytes_field(b'\x1a', signature) +
    (match external_signature {
      Some(value) => encode_bytes_field(b'\x22', value.encoded)
      None => b""
    }) +
    b"\x28\x01"
  let new_proof = encode_bytes_field(b'\x0a', next_seed)
  let result = prefix +
    encode_bytes_field(b'\x1a', block) +
    encode_bytes_field(b'\x22', new_proof)
  if result.length() > 1048576 {
    raise Malformed("token exceeds 1 MiB")
  }
  result
}

///|
/// Return a v1 third-party signing request for the token's current last block.
/// The serialized request contains the previous signature required by the spec.
pub fn create_third_party_request(
  token : Bytes,
  root_key : Bytes,
) -> Bytes raise TokenError {
  let blocks = verify_signed_chain(token, root_key)
  if blocks.length() == 0 {
    raise Malformed("token contains no blocks")
  }
  encode_bytes_field64(26, blocks[blocks.length() - 1].signature)
}

///|
/// Sign a block for a v1 third-party request using a 32-byte Ed25519 seed.
pub fn sign_third_party_request(
  request : Bytes,
  block_data : Bytes,
  external_seed : Bytes,
) -> ExternalSignature raise TokenError {
  sign_third_party_with_key(request, block_data, {
    algorithm: Ed25519,
    secret: external_seed,
  })
}

///|
pub fn sign_third_party_with_key(
  request : Bytes,
  block_data : Bytes,
  external : SigningKey,
) -> ExternalSignature raise TokenError {
  let external_seed = external.secret
  if request.length() > MAX_TOKEN_SIZE || block_data.length() > MAX_TOKEN_SIZE {
    raise Malformed("third-party signing input exceeds 1 MiB")
  }
  if external_seed.length() != 32 {
    raise Malformed("third-party seed must be 32 bytes")
  }
  let r = Reader::{ data: request, pos: 0, }
  let mut previous_signature : Bytes? = None
  while r.pos < request.length() {
    match r.varint() {
      10 | 18 =>
        raise Unsupported("legacy third-party request fields are not supported")
      26 if previous_signature is None => previous_signature = Some(r.bytes())
      26 => raise Malformed("duplicate previous signature in request")
      _ => raise Malformed("invalid third-party request")
    }
  }
  let previous = match previous_signature {
    Some(value) => value
    None => raise Malformed("third-party request has no previous signature")
  }
  if previous.length() != 64 && signature_raw(previous) is None {
    raise Malformed("invalid previous signature encoding")
  }
  let public_key = pack_key(verification_key(external)) catch {
    _ => raise Malformed("invalid third-party seed")
  }
  let payload = external_signature_payload_v1(block_data, previous)
  let signature = crypto_sign(external, payload) catch {
    _ => raise Malformed("could not create third-party signature")
  }
  let key_message = encode_public_key(public_key)
  let encoded = encode_bytes_field(b'\x0a', signature) +
    encode_bytes_field(b'\x12', key_message)
  { public_key, signature, encoded, }
}

///|
/// Create serializable third-party block contents from a signing request.
pub fn build_third_party_block(
  request : Bytes,
  block_data : Bytes,
  external_seed : Bytes,
) -> ThirdPartyBlockContents raise TokenError {
  {
    payload: block_data,
    external_signature: sign_third_party_request(
      request, block_data, external_seed,
    ),
  }
}

///|
/// Serialize ThirdPartyBlockContents using the official protobuf schema.
pub fn serialize_third_party_block(contents : ThirdPartyBlockContents) -> Bytes {
  encode_bytes_field64(10, contents.payload) +
  encode_bytes_field64(18, contents.external_signature.encoded)
}

///|
/// Parse a serialized ThirdPartyBlockContents response from a remote signer.
pub fn parse_third_party_block(
  data : Bytes,
) -> ThirdPartyBlockContents raise TokenError {
  if data.length() > MAX_TOKEN_SIZE {
    raise Malformed("third-party contents exceed 1 MiB")
  }
  let r = Reader::{ data, pos: 0, }
  let mut payload : Bytes? = None
  let mut external_signature : ExternalSignature? = None
  while r.pos < data.length() {
    match r.varint() {
      10 if payload is None => payload = Some(r.bytes())
      18 if external_signature is None =>
        external_signature = Some(parse_external_signature(r.bytes()))
      10 | 18 => raise Malformed("duplicate third-party block field")
      _ => raise Unsupported("unknown third-party block field")
    }
  }
  match (payload, external_signature) {
    (Some(block), Some(signature)) =>
      { payload: block, external_signature: signature, }
    _ => raise Malformed("incomplete third-party block contents")
  }
}

///|
/// Append a block signed by an external Ed25519 authority.
pub fn append_third_party_block(
  token : Bytes,
  root_key : Bytes,
  block_data : Bytes,
  next_seed : Bytes,
  external_signature : ExternalSignature,
) -> Bytes raise TokenError {
  append_third_party_typed(
    token,
    root_key,
    block_data,
    { algorithm: Ed25519, secret: next_seed, },
    external_signature,
  )
}

///|
fn append_third_party_typed(
  token : Bytes,
  root_key : Bytes,
  block_data : Bytes,
  next : SigningKey,
  external_signature : ExternalSignature,
) -> Bytes raise TokenError {
  let blocks = verify_signed_chain(token, root_key)
  if blocks.length() == 0 {
    raise Malformed("token contains no blocks")
  }
  let previous = blocks[blocks.length() - 1].signature
  if !crypto_verify(
      external_signature.public_key,
      external_signature_payload_v1(block_data, previous),
      external_signature.signature,
    ) {
    raise InvalidSignature
  }
  let encoded_signature = encode_bytes_field(
      b'\x0a',
      external_signature.signature,
    ) +
    encode_bytes_field(
      b'\x12',
      encode_public_key(external_signature.public_key),
    )
  let canonical = {
    public_key: external_signature.public_key,
    signature: external_signature.signature,
    encoded: encoded_signature,
  }
  let datalog = parse_encoded_fact_block(block_data)
  if datalog.version < 5 {
    raise Unsupported("third-party blocks require Datalog version 3.2")
  }
  append_raw_with_external(token, root_key, block_data, next, Some(canonical))
}

///|
/// Append a serialized block returned by an external third-party signer.
pub fn append_serialized_third_party_block(
  token : Bytes,
  root_key : Bytes,
  contents : Bytes,
  next_seed : Bytes,
) -> Bytes raise TokenError {
  let parsed = parse_third_party_block(contents)
  append_third_party_block(
    token,
    root_key,
    parsed.payload,
    next_seed,
    parsed.external_signature,
  )
}
